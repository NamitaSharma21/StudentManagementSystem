@model IEnumerable<StudentManagement.Models.Student>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="stylesheet" href="~/css/Dashboard.css" />


<div class="dashboard-container">


    <div class="dashboard-header">


        <div>
            <h2>Admin Dashboard</h2>
            <p>Manage student records</p>
        </div>


        <a asp-action="AddStudent"
           asp-controller="Admin"
           class="add-btn">

            <i class="bi bi-person-plus-fill"></i>
            Add Student

        </a>


    </div>





    <div class="table-container">


        <div class="table-top">


            <h3>Added Students</h3>



            <form asp-action="Dashboard"
                  method="get"
                  class="search-box">


                <i class="bi bi-search"></i>


                <input type="text"
                       name="search"
                       placeholder="Search Student..." />


                <button type="submit">
                    Search
                </button>


            </form>



        </div>





        <table>


            <thead>

                <tr>

                    <th>Name</th>
                    <th>Username</th>
                    <th>Course</th>
                    <th>Department</th>
                    <th>Semester</th>
                    <th>CGPA</th>
                    <th>Actions</th>

                </tr>

            </thead>





            <tbody>


                @if(Model != null && Model.Any())
                {

                    foreach(var student in Model)
                    {

                        <tr>


                            <td>
                                @student.Name
                            </td>


                            <td>
                                @student.Username
                            </td>


                            <td>
                                @student.Course
                            </td>


                            <td>
                                @student.Department?.DepartmentName
                            </td>


                            <td>
                                @student.Semester
                            </td>


                            <td>
                                @student.CGPA
                            </td>




                            <td>


                                <!-- View -->

                                <a asp-action="StudentDetails"
                                   asp-route-id="@student.ID"
                                   class="action view"
                                   title="View">

                                    <i class="bi bi-eye-fill"></i>

                                </a>




                                <!-- Edit -->

                                <a asp-action="EditStudent"
                                   asp-route-id="@student.ID"
                                   class="action edit"
                                   title="Edit">

                                    <i class="bi bi-pencil-square"></i>

                                </a>





                                <!-- Delete -->

                                <a asp-action="DeleteStudent"
                                   asp-route-id="@student.ID"
                                   class="action delete"
                                   title="Delete"
                                   onclick="return confirm('Are you sure you want to delete this student?');">


                                    <i class="bi bi-trash-fill"></i>


                                </a>



                            </td>


                        </tr>

                    }

                }

                else
                {

                    <tr>

                        <td colspan="7"
                            class="no-data">

                            No Students Added Yet

                        </td>

                    </tr>

                }


            </tbody>



        </table>



    </div>



</div>