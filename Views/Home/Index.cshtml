@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="home-container">

    <!-- HERO -->
    <div class="hero">

        <div class="hero-text">
            <h1>Student Management System</h1>

            <p>
                Manage student records, departments, courses and academic
                information through one centralized platform.
            </p>

        </div>

        <div class="hero-image">
            <img src="~/images/skillldev.png" alt="Student Management">
        </div>

    </div>

    <!-- FEATURES -->

    <div class="features">

        <div class="card">
            <h3>Student Registration</h3>
            <p>
                Register students with personal and academic details.
            </p>
        </div>

        <div class="card">
            <h3>Department Management</h3>
            <p>
                Organize departments and manage student information.
            </p>
        </div>

        <div class="card">
            <h3>Secure Login</h3>
            <p>
                Login using Student or Admin credentials securely.
            </p>
        </div>

        <div class="card">
            <h3>Student Dashboard</h3>
            <p>
                View profile, semester, CGPA and department details.
            </p>
        </div>

        <div class="card">
            <h3>Admin Panel</h3>
            <p>
                Search students, update records and manage data.
            </p>
        </div>

        <div class="card">
            <h3>Fast & Responsive</h3>
            <p>
                Clean interface with modern responsive design.
            </p>
        </div>

    </div>

    <!-- ABOUT -->

   <div class="about-section" id="about">

    <h2>About Student Management System</h2>

    <p>
        Student Management System is a centralized web application developed
        to simplify the management of student information, departments and
        academic records.
    </p>

    <p>
        Students can register, log in and view their academic details, while
        administrators can manage student records, departments and monitor
        academic information efficiently.
    </p>

    <p>
        This project is built using <strong>ASP.NET Core MVC</strong>,
        <strong>SQL Server</strong> and <strong>Entity Framework Core</strong>
        following the MVC architecture with a clean and responsive user
        interface.
    </p>

    </div>
</div>