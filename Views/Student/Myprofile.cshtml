@model StudentManagement.Models.Student

@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/MyProfile.css" />


<div class="profile-container">


    <div class="profile-card">


        <div class="profile-top">

            <div class="profile-image">

                <i class="bi bi-person-circle"></i>

            </div>


            <h2>
                @Model.Name
            </h2>

            <p>
                Student Profile
            </p>

        </div>



        <div class="profile-details">


            <div class="info-box">

                <span>Name</span>
                <h4>@Model.Name</h4>

            </div>


            <div class="info-box">

                <span>Username</span>
                <h4>@Model.Username</h4>

            </div>


            <div class="info-box">

                <span>Course</span>
                <h4>@Model.Course</h4>

            </div>


            <div class="info-box">

                <span>Department</span>
                <h4>@Model.Department?.DepartmentName</h4>

            </div>


            <div class="info-box">

                <span>Semester</span>
                <h4>@Model.Semester</h4>

            </div>


            <div class="info-box">

                <span>CGPA</span>
                <h4>@Model.CGPA</h4>

            </div>


            <div class="info-box">

                <span>Mobile Number</span>
                <h4>@Model.MobileNo</h4>

            </div>


            <div class="info-box">

                <span>Hometown</span>
                <h4>@Model.Hometown</h4>

            </div>


        </div>


    </div>


</div>